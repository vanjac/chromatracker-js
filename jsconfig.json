{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "checkJs": true,
        "skipLibCheck": false,
        "noEmit": true,

        "strictNullChecks": false,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
    },
    "exclude": [
        "build/",
        "scripts/",
    ],
}
